# Copier ce fichier vers .env puis adapter les valeurs.

# --- Serveur API ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=woodstock

# --- Authentification (JWT) ---
# Générer une valeur aléatoire longue, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-cette-valeur-par-une-chaine-aleatoire-longue
JWT_EXPIRES_IN=8h
